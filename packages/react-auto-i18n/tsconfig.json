        "jsx": "react-jsx",
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "moduleResolution": "node16",
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": ["src"]
}
